# Optional locally; required on Render or when COOKIE_SECURE=true.
# Generate a private value with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
COOKIE_SECURE=false

# Comma-separated frontend origins. Override in Render with the HTTPS origin only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://prismflow.thanabh.at

# Leave empty to use the publicly documented demo accounts.
EXTERNAL_AUTH_URL=
